# Template for the settings file. `icloud-mail-mcp --setup` creates the real one at
#   Mac/Linux: ~/.config/icloud-mail-mcp/.env     Windows: %APPDATA%\icloud-mail-mcp\.env
# (run `icloud-mail-mcp --config-path` to see it). Copy any extra settings from here.

# Your iCloud address. Used as the From address and the SMTP login.
ICLOUD_EMAIL=you@icloud.com

# IMAP login. Usually the part of your address before @icloud.com.
# Defaults to ICLOUD_EMAIL if left empty.
ICLOUD_IMAP_USER=you

# Apple ID email for Calendar and Contacts. Defaults to ICLOUD_EMAIL; set it if
# your mail address is a custom domain and your Apple ID is a different address.
ICLOUD_APPLE_ID=

# App-specific password from appleid.apple.com.
# Better: leave this empty; `--setup` keeps it in the macOS Keychain /
# Windows Credential Manager instead.
ICLOUD_APP_PASSWORD=

# Your other addresses (custom-domain, @me.com, Hide My Email), comma-separated,
# so replies never get addressed back to you. Your @icloud/@me/@mac twins are automatic.
ICLOUD_ALIASES=

# --- Safety -----------------------------------------------------------------
# Offer Claude only the tools that read. Nothing can be changed, sent or saved.
ICLOUD_READ_ONLY=false
# Sending is OFF by default: Claude can only save drafts for you to send.
ICLOUD_ALLOW_SEND=false
# If sending is on, only allow these recipients. Entries starting with @ match
# a whole domain. Empty = any recipient.
ICLOUD_SEND_ALLOWLIST=
# Save a copy of sent mail to "Sent Messages". Set false if you see duplicates.
ICLOUD_SAVE_SENT=true

# --- Calendar ----------------------------------------------------------------
# Calendar for new events (default: one called "Calendar" or "Home").
ICLOUD_DEFAULT_CALENDAR=
# Time zone for event times, e.g. Europe/London (default: your computer's).
ICLOUD_TIMEZONE=

# --- Limits -----------------------------------------------------------------
# Seconds to wait to reach iCloud, then for each response.
ICLOUD_CONNECT_TIMEOUT=10
ICLOUD_TIMEOUT=30
ICLOUD_MAX_BODY_CHARS=8000
# Messages too large to hold an attachment under this cap are not downloaded.
ICLOUD_MAX_ATTACHMENT_MB=25
# Let get_attachment save programs and scripts (.exe, .app, .command, .js ...).
ICLOUD_ALLOW_EXECUTABLES=false
# Where get_attachment saves files.
ICLOUD_ATTACHMENT_DIR=~/Downloads/icloud-mail
